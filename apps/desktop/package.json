{
  "name": "@arke/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell that embeds the coordinator and serves the React client as one signed app (PRD §8.6, D16; SPEC-022).",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --target=node20 --external:electron --outdir=dist --out-extension:.js=.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "start": "npm run build && electron dist/main.cjs"
  },
  "dependencies": {
    "@arke/coordinator": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.4.11",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
